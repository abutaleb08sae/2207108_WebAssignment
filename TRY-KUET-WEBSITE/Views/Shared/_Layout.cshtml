<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TRY | KUET Social Service Club</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <nav>
        <div class="logo-container">
            <img src="~/assets/logo.png" alt="TRY Logo" class="logo-img">
            <span>TRY</span>
        </div>
        <ul>
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li><a href="@Url.Action("Index", "Home")#about-section">About</a></li>
            <li><a href="@Url.Action("Activities", "Home")">Activities</a></li>
            <li><a href="@Url.Action("ExecutivePanel", "Home")">Executive Panel</a></li>
            <li><a href="@Url.Action("Index", "Donations")">Join Our Mission</a></li>
        </ul>
    </nav>

    <div class="container-fluid p-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="footer-grid-layout">
            <div class="footer-column brand-info">
                <div class="footer-logo-container">
                    <img src="~/assets/logo.png" alt="TRY Logo" class="footer-logo">
                    <span>TRY</span>
                </div>
                <p class="connect-text">Connect with us :</p>
                <div class="social-links-grid">
                    <a href="https://facebook.com" target="_blank" class="social-icon-circle">
                        <svg viewBox="0 0 24 24"><path d="M9 8H7v3h2v9h3v-9h3l.5-3H12V6c0-.88.22-1 1-1h2V2h-3c-2.42 0-4 1.35-4 4v2z" /></svg>
                    </a>
                    <a href="https://linkedin.com" target="_blank" class="social-icon-circle">
                        <svg viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.8v8.37h2.8v-4.67c0-.25.015-.51.09-.69a.7.7 0 0 1 .66-.47c.46 0 .8.35.8.87v4.96zm-10.75-9.64a1.44 1.44 0 1 0-1.44-1.44 1.44 0 0 0 1.44 1.44zm1.4 9.64V9.83h-2.8v8.37z" /></svg>
                    </a>
                    <a href="https://youtube.com" target="_blank" class="social-icon-circle">
