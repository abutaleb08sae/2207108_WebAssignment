                    </a>
                    <a href="https://instagram.com" target="_blank" class="social-icon-circle">
                        <svg viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.67 1.6 4.83 4.83.05 1.27.06 1.64.06 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.57 4.67-4.83 4.82-1.27.06-1.64.06-4.85.06s-3.58-.01-4.85-.06c-3.24-.15-4.67-1.6-4.82-4.82-.06-1.27-.06-1.64-.06-4.85s.01-3.58.06-4.85c.15-3.24 1.58-4.67 4.82-4.82 1.27-.06 1.64-.06 4.85-.06M12 0C8.74 0 8.33.01 7.05.07c-4.27.2-6.66 2.59-6.86 6.86C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.27 2.59 6.66 6.86 6.86 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c4.27-.2 6.66-2.59 6.86-6.86.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.27-2.59-6.66-6.86-6.86C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.84a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z" /></svg>
                    </a>
                </div>
            </div>

            <div class="footer-column info-links">
                <h3>CONTACT</h3>
                <p><strong>HOTLINE :</strong></p>
                <p>01745740110</p>
                <p>01988027300</p>
                <p>01791010971</p>
                <p class="email-row"><strong>EMAIL :</strong><br>trykuet@gmail.com</p>
            </div>

            <div class="footer-column info-links">
                <h3>ADDRESS</h3>
                <p class="address-text">Khulna University of Engineering & Technology (KUET), Khulna-9203, Bangladesh</p>
            </div>

            <div class="footer-column info-links">
                <h3>USEFUL LINK</h3>
                <ul>
                    <li><a href="@Url.Action("Index", "Home")">» Home</a></li>
                    <li><a href="@Url.Action("Index", "Home")#about-section">» About Us</a></li>
                    <li><a href="@Url.Action("Activities", "Home")">» Our Activities</a></li>
                    <li><a href="@Url.Action("ExecutivePanel", "Home")">» Executive Panel</a></li>
                    <li><a href="@Url.Action("Index", "Donations")">» Join Our Mission</a></li>
                    <li><a href="https://lnkd.in/ginW8zKT" target="_blank">» Pre-order Hoodie</a></li>
                </ul>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>